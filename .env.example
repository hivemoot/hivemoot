# Local-only runtime config. Do not commit .env.

# Identity / workload / worker execution.
# Workers execute a driver directly. Triggers live in the controller plane.
# All production workflows run on the Python plugin engine.
AGENT_IDENTITY=hivemoot-agent
# Legacy shell workload override. No production workloads ship in the image;
# this is retained only for the shell loader's regression tests.
AGENT_WORKLOAD=
# Plugin stack for direct Hivemoot repo work. Use `github` for generic GitHub
# automation.
AGENT_PLUGINS=github,hivemoot-github
# Worker execution mode: once | loop
# Plugin stacks support `once`; `loop` is for the legacy shell workload loader.
AGENT_DRIVER=once

# Provider runtime: codex | gemini | claude | kilo | opencode
AGENT_PROVIDER=codex
# Auth mode: auto | api_key | subscription
# Default runtime is hardened for api_key mode.
# Subscription mode is intended for local development with
# docker-compose.subscription.local.yml.
AGENT_AUTH_MODE=api_key

# Required target repo in owner/repo format.
TARGET_REPO=owner/repo
# Workspace path inside container for this service.
WORKSPACE_ROOT=/workspace/repo
# Host-side path bound into the container at WORKSPACE_ROOT.
# Default ./data/repo preserves the layout from the previous ./data:/workspace
# mount (host path ./data/repo maps to /workspace/repo, same effective location).
# For multiple repos on one host, set WORKSPACE_DATA to a repo-specific path
# (e.g. ./data/myrepo) so each container can only access its own workspace.
WORKSPACE_DATA=./data/repo
# Host-side path bound into the container at AGENT_MEMORY_DIR.
# Default ./data/memory/${AGENT_ID} scopes memory per agent.  For multi-repo
# setups, set this to a repo-specific path (e.g. ./data/memory/myrepo/agent-01).
AGENT_MEMORY_DATA=
# In-container path for persistent agent memory. Leave the default unless
# you also update the compose mount and prompt references.
AGENT_MEMORY_DIR=/home/node/.hivemoot/memory
# Prompt memory mode: rw injects memory plus write instructions, ro injects
# memory read-only, none disables memory injection entirely.
AGENT_MEMORY_MODE=rw

# Direct worker contract.
AGENT_ID=
AGENT_TOKEN=
AGENT_TOKEN_FILE=

# Controller agent slots (up to 10).
# The host controller uses these to route jobs to named agents.
# The worker runtime still accepts slot 01 as a compatibility fallback.
AGENT_ID_01=
AGENT_GITHUB_TOKEN_01=
AGENT_GITHUB_TOKEN_01_FILE=

AGENT_ID_02=
AGENT_GITHUB_TOKEN_02=
AGENT_GITHUB_TOKEN_02_FILE=

AGENT_ID_03=
AGENT_GITHUB_TOKEN_03=
AGENT_GITHUB_TOKEN_03_FILE=

AGENT_ID_04=
AGENT_GITHUB_TOKEN_04=
AGENT_GITHUB_TOKEN_04_FILE=

AGENT_ID_05=
AGENT_GITHUB_TOKEN_05=
AGENT_GITHUB_TOKEN_05_FILE=

AGENT_ID_06=
AGENT_GITHUB_TOKEN_06=
AGENT_GITHUB_TOKEN_06_FILE=

AGENT_ID_07=
AGENT_GITHUB_TOKEN_07=
AGENT_GITHUB_TOKEN_07_FILE=

AGENT_ID_08=
AGENT_GITHUB_TOKEN_08=
AGENT_GITHUB_TOKEN_08_FILE=

AGENT_ID_09=
AGENT_GITHUB_TOKEN_09=
AGENT_GITHUB_TOKEN_09_FILE=

AGENT_ID_10=
AGENT_GITHUB_TOKEN_10=
AGENT_GITHUB_TOKEN_10_FILE=

# Provider credentials (api_key mode only).
OPENAI_API_KEY_FILE=
GOOGLE_API_KEY_FILE=
GEMINI_API_KEY_FILE=
ANTHROPIC_API_KEY_FILE=
OPENROUTER_API_KEY_FILE=
ZAI_API_KEY_FILE=
CLAUDE_CODE_OAUTH_TOKEN_FILE=
CLAUDE_CODE_OAUTH_TOKEN=

# Kilo provider settings (AGENT_PROVIDER=kilo only).
# Authentication modes:
#   - BYOK (recommended): Set KILO_PROVIDER + matching API key for direct model access
#     (no rate limits, full control, lower long-term cost)
#   - Gateway: Set KILOCODE_TOKEN for Kilo's managed service
#     (single token, simpler setup, rate limited, higher cost)
#
# KILO_PROVIDER selects the underlying AI model provider for BYOK mode
# (e.g. anthropic, openai, google, openrouter). Required unless using
# KILOCODE_TOKEN for gateway mode.
KILO_PROVIDER=
# Model override for Kilo (provider-specific, e.g. claude-sonnet-4-20250514).
KILO_MODEL=
# Optional gateway token (alternative to BYOK — uses Kilo's managed service).
KILOCODE_TOKEN_FILE=

# OpenCode provider config (AGENT_PROVIDER=opencode only).
# OPENCODE_PROVIDER selects the underlying model provider (e.g. zai).
# OPENCODE_MODEL overrides the default model for that provider.
OPENCODE_PROVIDER=
OPENCODE_MODEL=

# Optional model override per provider.
AGENT_MODEL=

# Legacy in-container loop driver scheduling (AGENT_DRIVER=loop).
PERIODIC_INTERVAL_SECS=3600
PERIODIC_JITTER_SECS=300
MAX_CONSECUTIVE_FAILURES=5
# Per-agent failure cooldown for periodic runs.
# Delay grows exponentially from BASE to MAX and resets after a successful run.
PERIODIC_AGENT_FAILURE_BACKOFF_BASE_SECS=300
PERIODIC_AGENT_FAILURE_BACKOFF_MAX_SECS=3600
PERIODIC_AGENT_FAILURE_BACKOFF_JITTER_PCT=15

# Host-side controller (Phase 2). Canonical entrypoint: controller/main.sh.
# Controller run mode: once | loop
CONTROLLER_RUN_MODE=once
# Host path for controller job specs, logs, and per-job workspaces.
CONTROLLER_WORKSPACE_ROOT=
# Max concurrent worker containers spawned by this controller process.
CONTROLLER_MAX_WORKERS=1
# Optional host-wide worker cap shared across multiple controller services.
# Disabled by default. Set both GLOBAL_MAX_WORKERS (>0) and an existing
# GLOBAL_SLOTS_DIR to enable the shared flock semaphore.
GLOBAL_MAX_WORKERS=0
GLOBAL_SLOTS_DIR=
# Trigger-specific wait budgets (seconds) when acquiring a shared global slot.
GLOBAL_SLOT_TIMEOUT_PERIODIC_SECS=300
GLOBAL_SLOT_TIMEOUT_MENTION_SECS=600
GLOBAL_SLOT_TIMEOUT_TASK_SECS=600
# Docker image used for spawned workers.
WORKER_IMAGE=hivemoot-agent:local
# Optional lock/token temp paths for the host-side controller.
# Lock files default to /tmp/hivemoot-controller-locks for reliable flock semantics.
CONTROLLER_LOCK_DIR=
CONTROLLER_TOKEN_TMP_ROOT=
# Graceful stop timeout (seconds) when shutting down active worker containers.
CONTROLLER_SHUTDOWN_GRACE_SECS=30
# Container name prefix for controller-spawned worker containers.
CONTROLLER_WORKER_NAME_PREFIX=hivemoot-worker
# How often (seconds) the controller runs queue maintenance (orphan recovery + artifact pruning).
QUEUE_MAINTENANCE_INTERVAL_SECS=60
# Retention window (seconds) for completed and failed queue artifacts before pruning.
# Default 7 days (604800). Lower to keep queue scan fast at high mention volume.
# ADR-001 T2 trigger fires if artifact count exceeds 1000 and scan latency exceeds 200ms.
QUEUE_ARTIFACT_TTL_SECS=604800
# Retention window (seconds) for terminal-state job workspaces before pruning.
# Applies to completed/failed/cancelled jobs. Set 0 to disable workspace pruning.
# Default 24 hours (86400).
WORKSPACE_TTL_SECS=86400
# Extra grace period (seconds) beyond AGENT_TIMEOUT_SECONDS before a .processing file
# is recovered as an orphan. Increase if workers regularly run close to timeout.
ORPHAN_RECOVERY_GRACE_SECS=0

# Mention watching (controller-owned trigger; do not use in direct workers).
# Requires user tokens (not installation tokens) and TARGET_REPO.
WATCH_MENTIONS=
WATCH_POLL_INTERVAL=300
# Cooldown before a failed mention/review-request event is eligible for retry again.
# Set 0 to disable this backoff and retry on every re-emitted event.
WATCH_TRIGGER_FAILURE_BACKOFF_SECS=300
# Review-request watching (requires WATCH_MENTIONS=1).
# When enabled, a separate watcher per agent listens for review_requested
# notifications and routes them as review jobs with a dedicated prompt and
# review-pr:<number> session key.
WATCH_REVIEW_REQUESTS=0
# Task watching (host controller only).
# When WATCH_TASKS=1, controller claims delegated tasks via AGENT_TASK_CLAIM_URL
# and launches isolated hivemoot-task workers.
# Task claim poll interval in seconds (default 120).
WATCH_TASKS=
TASK_POLL_INTERVAL_SECS=120
# Comma-separated AGENT_ID allowlist for delegated task dispatch.
# Required when WATCH_TASKS=1 (for example: attendant,worker).
TASK_DISPATCH_AGENT_IDS=
# Plugin stack launched for claimed tasks. Defaults to github,hivemoot-task.
TASK_DISPATCH_PLUGINS=github,hivemoot-task

# Runtime behavior.
AGENT_TIMEOUT_SECONDS=1800
# Enable/disable session resume for mention and task follow-ups (1=on, 0=off).
SESSION_RESUME=1
# Backward-compatible alias still supported by run-once.sh:
# SESSION_RESUME_ENABLED=1
# Resume eligibility windows (hours).
SESSION_RESUME_MAX_IDLE_HOURS=12
SESSION_RESUME_MAX_AGE_HOURS=24
# Daily session reset hour (0-23, local TZ). Sessions created before this hour
# are expired on next use, forcing a fresh context. Leave empty to disable.
SESSION_RESET_AT_HOUR=
# Shallow clone depth. Default 50 covers most agent work. Set 0 for full clone
# (needed for blame/log archaeology). Existing checkouts are reused automatically
# via fetch + reset instead of re-cloning.
GIT_CLONE_DEPTH=50
# Override the default agent system prompt. Path must be absolute inside the
# container. Leave empty to use the built-in plugin prompt
# (for example `cli/hivemoot_agent/plugins_builtin/hivemoot_github/prompts/autonomous.md` or
# `cli/hivemoot_agent/plugins_builtin/hivemoot_task/prompts/task.md`).
AGENT_PROMPT_FILE=
# Composable skill modules to inject into the agent system prompt, as a
# comma-separated list of skill names (e.g. security-reviewer).
# Each name maps to skills/<name>/SKILL.md inside the container.
# Skill files can be mounted via a volume at that path. Missing files are fatal.
# Host controller only: newline-separated read-only bind mounts for custom
# skill directories. Format:
# /absolute/host/skill-dir:/opt/hivemoot-agent/skills/<name>:ro
AGENT_SKILL_BIND_MOUNTS=
# Selected skills for the current run.
# All supported providers load these skills natively in the Python runtime.
# Claude gets an ephemeral --plugin-dir. Codex, Gemini, OpenCode, and Kilo get
# an ephemeral workspace .agents/skills staging directory. Built-in plugin skill
# packs and bind-mounted /opt/hivemoot-agent/skills entries both participate in
# resolution, and full skill directories stay intact.
# Multi-agent runtimes can override a specific slot with AGENT_SKILLS_01,
# AGENT_SKILLS_02, etc. When unset, each slot falls back to AGENT_SKILLS.
AGENT_SKILLS=
# Additional native-discovery skills to expose alongside AGENT_SKILLS.
# Comma-separated skill names or "all" to load the full resolved skill set.
# Controller-global: applies to all workers in the service (no slot variants).
AGENT_AVAILABLE_SKILLS=
AGENT_SKILLS_01=
AGENT_SKILLS_02=
AGENT_SKILLS_03=
AGENT_SKILLS_04=
AGENT_SKILLS_05=
AGENT_SKILLS_06=
AGENT_SKILLS_07=
AGENT_SKILLS_08=
AGENT_SKILLS_09=
AGENT_SKILLS_10=
AGENT_EXTRA_PROMPT=
# Optional Hivemoot role override for autonomous repo work.
# Defaults to AGENT_ID (or legacy slot 01) when unset.
HIVEMOOT_BUZZ_ROLE=
# GitHub plugin settings (AGENT_PLUGINS=github or github,hivemoot-github).
# If GITHUB_WORKSPACE is empty, the plugin defaults to WORKSPACE_ROOT.
# hivemoot-github requires github to be listed first.
GITHUB_TOKEN=
GITHUB_TOKEN_FILE=
GITHUB_REPOS=
GITHUB_WORKSPACE=
GITHUB_CLONE_DEPTH=50
GITHUB_GIT_NAME=
GITHUB_GIT_EMAIL=
# Task workload (AGENT_WORKLOAD=hivemoot-task).
# Claim endpoint for machine executors. When AGENT_TASK_ID/AGENT_TASK_PROMPT/
# TARGET_REPO are all set, claim is skipped and those values are used.
AGENT_TASK_CLAIM_URL=
# Base URL for execute endpoint (for example: https://app.example.com/api/tasks).
# Task mode posts updates to: ${AGENT_TASK_EXECUTE_BASE_URL}/${taskId}/execute
AGENT_TASK_EXECUTE_BASE_URL=
# Heartbeat cadence for long-running task mode executions.
# 0 disables heartbeats. Recommended: 30-60 seconds.
AGENT_TASK_HEARTBEAT_INTERVAL_SECONDS=45
# Shared bearer token used by task mode and health reporting.
# Prefer *_FILE in production.
HIVEMOOT_AGENT_TOKEN=
HIVEMOOT_AGENT_TOKEN_FILE=
# Optional direct task injection (skips claim flow when AGENT_TASK_ID,
# AGENT_TASK_PROMPT, and TARGET_REPO are all set).
# Task runs default to AGENT_SESSION_KEY=task:<task_id> when SESSION_RESUME=1.
# If your backend reuses task IDs for unrelated work, set SESSION_RESUME=0.
AGENT_TASK_ID=
AGENT_TASK_PROMPT=
# Task claim token for execute updates (required whenever execute URL is used).
# Claim flow populates this automatically from /claim responses.
AGENT_TASK_CLAIM_TOKEN=
# Task mode writes local markdown artifacts to:
# ${WORKSPACE_ROOT}/task-output/<task_id>/result.md
# Provider-specific runtime options as a JSON object. Currently supports
# Codex: {"model_reasoning_effort": "low|medium|high|xhigh"}
AGENT_TOOL_OPTIONS_JSON=

# Per-job isolation. Auto-generated when empty (standalone runs only).
# Set explicitly for external correlation (e.g. CI pipeline ID).
# Workspace, HOME, and logs are namespaced under this ID; auth
# credentials are selectively seeded (conversation caches excluded).
# NOTE: Ignored in managed mode (run-loop.sh/controller); Phase 2 will adopt JOB_ID there.
JOB_ID=

# Build-time provider selection. Selects which AI provider CLI to install in
# the image. Default `all` installs every provider (backward-compatible).
# Set to a single provider name to reduce image size by ~60%:
#   all | codex | gemini | kilo | opencode | claude
# Note: DOCKER_PROVIDER controls the *image build*. AGENT_PROVIDER controls
# which provider runs at runtime. Keep them consistent.
DOCKER_PROVIDER=all

# CLI version pins for deterministic builds.
# Set to "latest" for development, or pin for reproducibility.
CODEX_VERSION=0.101.0
GEMINI_VERSION=0.28.2
KILO_VERSION=1.0.21
CLAUDE_CODE_VERSION=2.1.42
OPENCODE_VERSION=latest
HIVEMOOT_CLI_VERSION=0.1.17

# Container resource limits (all agents share one container).
AGENT_MEMORY_LIMIT=16g
AGENT_CPU_LIMIT=4.0
AGENT_PIDS_LIMIT=512

# Launch jitter between agents (seconds). Set both to 0 for no jitter.
LAUNCH_JITTER_MIN_SECS=120
LAUNCH_JITTER_MAX_SECS=180

# Hivemoot CLI update at runtime: auto (always update) | skip (use image version).
HIVEMOOT_CLI_UPDATE=auto

# Health reporting to backend (V2).
# Set HEALTH_REPORT_URL to enable; leave empty to disable.
HEALTH_REPORT_URL=
# Request timeout in seconds.
HEALTH_REPORT_TIMEOUT_SECS=10
# Max retries for 5xx/network errors per report cycle.
HEALTH_REPORT_MAX_RETRIES=2
# Periodic controller heartbeat interval in seconds (0 disables). Default: 1800 (30 min).
HEARTBEAT_INTERVAL_SECS=1800
# Include agent run summary in health reports (0=off, 1=on). Default: 0.
# Enable only after the backend HealthReport schema has been updated to accept run_summary.
HEALTH_REPORT_RUN_SUMMARY=0
# Include sanitized log tail in health reports on failure/timeout (0=off, 1=on). Default: 0.
# Enable only after the backend HealthReport schema has been updated to accept error_detail.
HEALTH_REPORT_ERROR_DETAIL=0

# ── Messaging ─────────────────────────────────────────────────────────────
# Messaging settings for controller watch mode and AGENT_PLUGINS=messaging.
# Enable messaging polling.  Requires CONTROLLER_RUN_MODE=loop.
WATCH_MESSAGING=0
# Platform adapter (controller/triggers/messaging-platforms/<name>.sh).
MESSAGING_PLATFORM=telegram
# Agent that handles messaging jobs.  Required when WATCH_MESSAGING=1.
MESSAGING_AGENT_ID=
# Chat IDs allowed to interact (comma-separated).  Empty = deny all.
MESSAGING_ALLOWED_CHAT_IDS=
# Telegram: bot token.  Prefer *_FILE in production.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_TOKEN_FILE=

# ── Task dispatch ──────────────────────────────────────────────────────────
# Backend URL for task claiming. Required when WATCH_TASKS=1.
AGENT_TASK_CLAIM_URL=
