#!/usr/bin/env python3
"""Wrapper script — allows running as `hivemoot-agent` without -m."""
import sys
import os

# Add the cli directory to the Python path so the package is importable
# without pip install.
cli_dir = os.path.dirname(os.path.abspath(__file__))
if cli_dir not in sys.path:
    sys.path.insert(0, cli_dir)

from hivemoot_agent.__main__ import main

sys.exit(main())
