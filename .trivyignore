# Transitive dependencies in bundled third-party tooling (npm and gh).
# We cannot patch these directly without an upstream release that includes
# fixed dependencies. Re-evaluate regularly and remove entries once fixed.

# tar 7.5.7 bundled in npm (node:24-slim) — arbitrary file read/write via
# hardlink target escape through symlink chains (fixed in 7.5.8)
# exp:2026-03-15 - remove once npm ships tar >= 7.5.8 in the base image
CVE-2026-26960

# Go stdlib in gh CLI binary — we install gh from GitHub's apt repo and
# cannot control the Go toolchain version it was compiled with.
# Re-evaluate when gh releases a build on Go ≥ 1.25.7.

# crypto/tls — unexpected session resumption (CRITICAL, fixed in Go 1.25.7)
# exp:2026-04-16 - re-evaluate once gh releases with patched Go stdlib
CVE-2025-68121

# net/url — memory exhaustion in query parameter parsing (fixed in Go 1.25.6)
# exp:2026-04-16 - re-evaluate once gh releases with patched Go stdlib
CVE-2025-61726

# archive/zip — excessive CPU building archive index (fixed in Go 1.25.6)
# exp:2026-04-16 - re-evaluate once gh releases with patched Go stdlib
CVE-2025-61728

# crypto/tls — TLS 1.3 handshake message handling (fixed in Go 1.25.6)
# exp:2026-04-16 - re-evaluate once gh releases with patched Go stdlib
CVE-2025-61730
