# Transitive dependencies in bundled third-party tooling (npm and gh).
# We cannot patch these directly without an upstream release that includes
# fixed dependencies. Re-evaluate regularly and remove entries once fixed.

# tar 7.5.7 bundled in npm (node:24-slim) — arbitrary file read/write via
# hardlink target escape through symlink chains (fixed in 7.5.8)
# exp:2026-03-15 - remove once npm ships tar >= 7.5.8 in the base image
CVE-2026-26960

# minimatch 9.0.5/10.1.2 in @hivemoot-dev/cli, @kilocode/cli — ReDoS via
# repeated wildcards with non-matching literal in pattern (fixed in 10.2.1)
# exp:2026-03-15 - remove once upstream packages bump minimatch >= 10.2.1
CVE-2026-26996
